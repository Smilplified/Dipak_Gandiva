# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — never expose to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Legacy Storage.list for voice/LHO when lead_assets is empty. Must stay false in production (Disk IO).
# ENABLE_STORAGE_LIST_FALLBACK=true

# ── Lead Finder (admin-only module) ─────────────────────────────────────────
# Server-only. On Vercel: Project → Settings → Environment Variables.
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxx
# Actor path (~ separates user/name). Defaults to code_crafter~leads-finder.
APIFY_ACTOR_ID=code_crafter~leads-finder
